-- 1. ESP (Все уровни)
local espEnabled = false
CreateToggle(TabESP, "Подсветка ролей (ESP)", function(state) espEnabled = state end)

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local backpack = player:FindFirstChild("Backpack")
            local character = player.Character
            local role = "Innocent"

            if backpack then
                if backpack:FindFirstChild("Knife") or character:FindFirstChild("Knife") then
                    role = "Murderer"
                elseif backpack:FindFirstChild("Gun") or character:FindFirstChild("Gun") then
                    role = "Sheriff"
                end
            end

            local highlight = character:FindFirstChild("MedjeuHighlight")
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "MedjeuHighlight"
                highlight.Parent = character
            end

            if role == "Murderer" then
                highlight.FillColor = Color3.fromRGB(255, 30, 30)
            elseif role == "Sheriff" then
                highlight.FillColor = Color3.fromRGB(30, 120, 255)
            else
                highlight.FillColor = Color3.fromRGB(30, 255, 100)
            end
        end
    end
end)

-- 2. Silent Aim / Aimbot (Plat)
local aimbotEnabled = false
CreateToggle(TabAim, "Silent Aim / Aimbot", function(state) aimbotEnabled = state end)

RunService.RenderStepped:Connect(function()
    if not aimbotEnabled or userTier == "Free" then return end
    local closestTarget = nil
    local shortestDist = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local backpack = player:FindFirstChild("Backpack")
            local character = player.Character
            local isMurderer = (backpack and backpack:FindFirstChild("Knife")) or character:FindFirstChild("Knife")

            if isMurderer then
                local pos, onScreen = Camera:WorldToViewportPoint(character.HumanoidRootPart.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestTarget = character.HumanoidRootPart
                    end
                end
            end
        end
    end

    if closestTarget then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
    end
end)

