local Tabs = {}
local function CreateTab(name, isPremiumOnly)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, -10, 0, 36)
    TabButton.Position = UDim2.new(0, 5, 0, 0)
    TabButton.BackgroundColor3 = Color3.fromRGB(25, 25, 34)
    TabButton.BorderSizePixel = 0
    TabButton.Text = name .. (isPremiumOnly and " [Plat]" or "")
    TabButton.TextColor3 = isPremiumOnly and Color3.fromRGB(150, 150, 160) or Color3.fromRGB(220, 220, 220)
    TabButton.TextSize = 12
    TabButton.Font = Enum.Font.GothamMedium
    TabButton.Parent = Sidebar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = TabButton

    local TabContent = Instance.new("ScrollingFrame")
    TabContent.Size = UDim2.new(1, 0, 1, 0)
    TabContent.BackgroundTransparency = 1
    TabContent.Visible = false
    TabContent.ScrollBarThickness = 3
    TabContent.Parent = ContentContainer

    local Layout = Instance.new("UIListLayout")
    Layout.Parent = TabContent
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 8)

    TabButton.MouseButton1Click:Connect(function()
        if isPremiumOnly and userTier == "Free" then return end
        for _, t in pairs(Tabs) do t.Content.Visible = false end
        TabContent.Visible = true
    end)

    table.insert(Tabs, {Button = TabButton, Content = TabContent, Premium = isPremiumOnly})
    return TabContent
end

